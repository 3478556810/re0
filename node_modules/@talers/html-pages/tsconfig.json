{
	"compilerOptions": {
		"noEmit": true,
		"moduleResolution": "bundler",
		"module": "ES2022",
		"lib": ["ES2022", "DOM"],
		"esModuleInterop": true,
		"target": "ES2022",
		"verbatimModuleSyntax": true,
		"strict": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"baseUrl": ".",
		"allowJs": false,
		"noImplicitReturns": true
	}
}
