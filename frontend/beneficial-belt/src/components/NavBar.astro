---
import AdminLogin from './shanxi/AdminLogin.vue';
---

<nav class="navbar">
  <div class="nav-content">
    <div class="nav-brand">
      <a href="/">✨ 杉汐的星尘核心</a>
    </div>
    <ul class="nav-links" id="nav-links">
      <li><a href="/blog">杉汐的日记</a></li>
      <li><a href="/shanxi-hut">杉汐小屋</a></li>
      <li><a href="/timeline">生命线</a></li>
    </ul>
    <div class="nav-actions">
      <AdminLogin client:only="vue" />
    </div>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const ul = document.querySelector('.nav-links')!
    if (!ul) return

    function updateLinks() {
      // 移除旧的动态链接（直接调用 forEach，不需要额外变量）
      ul.querySelectorAll('.dynamic-link').forEach(el => el.remove())

      const token = localStorage.getItem('token')
      if (token) {
        const devLinks = [
          { href: '/resume', text: '关于他' },
          { href: '/image-bed', text: '图床' }
        ]
        devLinks.forEach(link => {
          const li = document.createElement('li')
          li.className = 'dynamic-link'
          const a = document.createElement('a')
          a.href = link.href
          a.textContent = link.text
          a.style.cssText = 'color: #475467; text-decoration: none; font-size: 0.95em;'
          a.addEventListener('mouseenter', () => { a.style.color = '#2563eb' })
          a.addEventListener('mouseleave', () => { a.style.color = '#475467' })
          li.appendChild(a)
          ul.appendChild(li)
        })
      }
    }

    updateLinks()
    window.addEventListener('storage', updateLinks)
    window.addEventListener('login-state-changed', updateLinks)
  })
</script>
<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid #e2e8f0;
    box-sizing: border-box;
  }

  .nav-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 30px;
  }

  .nav-brand a {
    color: #0f172a;
    text-decoration: none;
    font-size: 1.2em;
    font-weight: bold;
  }

  .nav-links {
    list-style: none;
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: #475467;
    text-decoration: none;
    transition: color 0.2s;
    font-size: 0.95em;
  }

  .nav-links a:hover {
    color: #2563eb;
  }

  .nav-actions {
    display: flex;
    align-items: center;
  }
</style>