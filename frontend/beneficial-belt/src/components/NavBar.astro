---
import AdminLogin from './shanxi/AdminLogin.vue';
---

<nav class="navbar">
  <div class="nav-content">
    <div class="nav-brand">
      <a href="/">杉汐的星尘核心</a>
    </div>
    <ul class="nav-links" id="nav-links">
      <li><a href="/reading-hut">阅读小屋</a></li>
      <li><a href="/blog">日记</a></li>
      <li><a href="/timeline">生命线</a></li>
    </ul>
    <div class="nav-actions">
      <AdminLogin client:only="vue" />
    </div>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const ul = document.querySelector('.nav-links')!
    if (!ul) return

    function updateLinks() {
      ul.querySelectorAll('.dynamic-link').forEach(el => el.remove())
      const token = localStorage.getItem('token')
      if (token) {
        const devLinks = [
          { href: '/resume', text: '关于他' },
          { href: '/image-bed', text: '图床' }
        ]
        devLinks.forEach(link => {
          const li = document.createElement('li')
          li.className = 'dynamic-link'
          const a = document.createElement('a')
          a.href = link.href
          a.textContent = link.text
          a.style.cssText = 'color: #475569; text-decoration: none; font-size: 0.9rem;'
          a.addEventListener('mouseenter', () => { a.style.color = '#0066cc' })
          a.addEventListener('mouseleave', () => { a.style.color = '#475569' })
          li.appendChild(a)
          ul.appendChild(li)
        })
      }
    }

    updateLinks()
    window.addEventListener('storage', updateLinks)
    window.addEventListener('login-state-changed', updateLinks)
  })
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(0, 102, 204, 0.1);
    box-sizing: border-box;
  }

  .nav-content {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 24px;
    height: 60px;
  }

  .nav-brand a {
    font-size: 1.3rem;
    font-weight: 600;
    color: #0066cc;
    text-decoration: none;
    letter-spacing: -0.3px;
  }

  .nav-links {
    list-style: none;
    display: flex;
    gap: 32px;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: #334155;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 450;
    transition: color 0.2s, border-color 0.2s;
    padding: 6px 0;
    border-bottom: 2px solid transparent;
  }

  .nav-links a:hover {
    color: #0066cc;
    border-bottom-color: #0066cc;
  }

  .nav-actions {
    display: flex;
    align-items: center;
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }
  }
</style>