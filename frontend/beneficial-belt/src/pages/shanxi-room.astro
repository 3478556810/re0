---
import NavBar from "../components/NavBar.astro";
import ShanxiRoom3D from "../components/shanxi/ShanxiRoom3D.vue";
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>杉汐的3D小屋 | 星尘核心</title>
    <style>
      @import "/src/styles/global.css";
      body {
        margin: 0;
        padding: 0;
        background: #1a1a2e;
        overflow: hidden;
        height: 100vh;
      }
      .room-container {
        width: 100%;
        height: 100vh;
        display: flex;
        flex-direction: column;
      }
    </style>
  </head>
  <body>
    <div class="room-container">
      <NavBar />
      <ShanxiRoom3D client:only="vue" />
    </div>
  </body>
</html>