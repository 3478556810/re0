---
// 注意这两条“虚线”，它们就是 frontmatter 的“围墙”
import PostEditor from "../components/blog/PostEditor.vue";
import PostList from "../components/blog/PostList.vue";
import ChatWidget from "../components/ChatWidget.astro";
import NavBar from "../components/NavBar.astro";
import Resume from "../components/resume/Resume.vue";
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>个人作品集</title>
    </head>

    <body>
        <!-- 插入导航栏 astro -->
        <NavBar />
        <!-- 插入简历 vue -->
        <Resume client:load/>
        <!-- 插入文章列表和编辑器 vue -->
        <PostList client:load />
        <PostEditor client:load />
        <!-- 插入Ai顾问 astro -->
        <ChatWidget />
    </body>
</html>
