---
import NavBar from "../components/NavBar.astro";
import ChatWidget from "../components/shanxi/ChatWidget.vue";
import ThemeProvider from "../components/ThemeProvider.vue";
import MusicPlayer from "../components/MusicPlayer.vue";
import ShanxiHome from '../components/shanxi/ShanxiHome.vue'
import AuthGuard from '../components/AuthGuard.astro';
import DailyImage from '../components/DailyImage.vue';
import RandomGallery from '../components/RandomGallery.vue';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <AuthGuard /> 
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>杉汐的星尘核心</title>
    <style>
      @import "/src/styles/global.css";
      
    </style>
  </head>
  <body>
    <ThemeProvider client:only="vue">
      <div class="app-container">
        <NavBar />
        <div class="content">
          <!-- 可选的 ShanxiHome 如果启用请取消注释 -->
          <!-- <ShanxiHome client:only="vue" /> -->
          <DailyImage client:only="vue" />
          <RandomGallery client:only="vue" />
        </div>
       
        <MusicPlayer client:only="vue" />
      </div>
    </ThemeProvider>
  </body>
</html>