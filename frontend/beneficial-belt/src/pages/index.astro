<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>领袖的简历 | shanca.me</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 800px; margin: 50px auto; padding: 0 20px; line-height: 1.6; color: #333; }
        h1 { border-bottom: 2px solid #333; padding-bottom: 10px; }
        h2 { color: #555; margin-top: 30px; }
        .section { margin-bottom: 20px; }
        .tag { display: inline-block; background: #f0f0f0; padding: 2px 8px; margin: 2px; border-radius: 3px; }
    </style>
</head>
<body>
    <h1>领袖的个人简历</h1>
    
    <div class="section">
        <h2>关于我</h2>
        <p>曾独立完成智慧种植系统（获全国三等奖）、公网聊天室等项目。2023年首批调用ChatGPT API的先锋开发者。具备极强的自学能力、拆解问题的逻辑和向内求索的定力。短期休整后，现已准备好重新投入战斗。</p>
    </div>

    <div class="section">
        <h2>核心技能</h2>
        <span class="tag">Java</span>
        <span class="tag">Spring Cloud</span>
        <span class="tag">Redis</span>
        <span class="tag">Docker</span>
        <span class="tag">Vue.js</span>
        <span class="tag">Python</span>
        <span class="tag">MySQL</span>
        <span class="tag">Linux运维</span>
        <span class="tag">UML系统设计</span>
    </div>

    <div class="section">
        <h2>联系方式</h2>
        <p>📧 你的邮箱地址</p>
        <p>🌐 <a href="https://shanca.me">shanca.me</a></p>
    </div>
    <style>
    /* 聊天窗口的样式 */
    #advisor-widget { position: fixed; right: 20px; bottom: 20px; width: 300px; border: 1px solid #ccc; border-radius: 10px; background: white; box-shadow: 0 4px 8px rgba(0,0,0,0.1); font-family: Arial, sans-serif; z-index: 9999; }
    #advisor-header { background: #2c3e50; color: white; padding: 10px; border-radius: 10px 10px 0 0; cursor: pointer; }
    #advisor-body { height: 300px; overflow-y: auto; padding: 10px; background: #f9f9f9; }
    #advisor-input { display: flex; border-top: 1px solid #eee; }
    #advisor-input input { flex: 1; border: none; padding: 10px; }
    #advisor-input button { background: #2c3e50; color: white; border: none; padding: 10px 15px; cursor: pointer; }
    .msg { margin-bottom: 8px; }
    .user { text-align: right; color: #2c3e50; }
    .bot { text-align: left; color: #555; }
</style>

<div id="advisor-widget">
    <div id="advisor-header" onclick="document.getElementById('advisor-body').style.display = document.getElementById('advisor-body').style.display === 'none' ? 'block' : 'none'">🤖 我的AI顾问 (点击收起)</div>
    <div id="advisor-body">
        <div class="msg bot">你好！我是领袖的数字顾问，有什么想了解的？</div>
    </div>
    <div id="advisor-input">
        <input type="text" id="user-input" placeholder="输入你的问题...">
        <button id="send-button">发送</button>
    </div>
</div>

<script>
// 前端JS函数，用来和后端Go服务通信
async function askAdvisor() {
    // 确保 input 和 body 不为空，并显式转换为正确的类型
    const input = document.getElementById('user-input') as HTMLInputElement | null;
    if (!input) return;

    const question = input.value.trim();
    if (!question) return;

    // 确保聊天记录区域存在
    const body = document.getElementById('advisor-body');
    if (!body) return;

    // 在聊天框里显示用户的问题
    const userDiv = document.createElement('div');
    userDiv.className = 'msg user';
    userDiv.textContent = `你：${question}`;
    body.appendChild(userDiv);

    input.value = '';

    try {
        // 向后端Go服务发请求。
        const response = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: question })
        });
        const data = await response.json();

        // 在聊天框里显示AI的回答
        const botDiv = document.createElement('div');
        botDiv.className = 'msg bot';
        botDiv.textContent = `顾问：${data.reply}`;
        body.appendChild(botDiv);
    } catch (error) {
        const errDiv = document.createElement('div');
        errDiv.className = 'msg bot';
        errDiv.textContent = `顾问：抱歉，网络似乎开小差了。`;
        body.appendChild(errDiv);
    }
}

// 绑定事件
const sendButton = document.getElementById('send-button') as HTMLButtonElement | null;
if (sendButton) {
    sendButton.onclick = askAdvisor;
}
const userInput = document.getElementById('user-input') as HTMLInputElement | null;
if (userInput) {
    userInput.onkeypress = (e) => {
        if (e.key === 'Enter') {
            askAdvisor();
        }
    };
}
</script>
</body>
</html>