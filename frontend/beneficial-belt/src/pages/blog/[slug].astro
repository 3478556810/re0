---
import NavBar from '../../components/NavBar.astro';
import ChatWidget from '../../components/shanxi/ChatWidget.vue';
export const prerender = false;  // 不预渲染，用户访问时动态加载
export async function getStaticPaths() {
  try {
    const res = await fetch('http://localhost:8080/api/posts')
    if (res.ok) {
      const posts = await res.json()
      return posts.map((p: any) => ({ params: { slug: p.slug } }))
    }
  } catch (e) {}
  return [{ params: { slug: 'hello-world' } }]
}
const { slug } = Astro.params;

// 从后端 API 获取文章数据
const response = await fetch('http://localhost:8080/api/posts');
const posts = await response.json();
const post = posts.find((p: any) => p.slug === slug);
---

<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post ? post.title + ' | 杉汐的日记本' : '文章未找到'}</title>
    <style>
      @import "/src/styles/global.css";
    </style>
  </head>
  <body>
    <NavBar />
    <ChatWidget client:only="vue" />

    <div class="blog-container">
      {post ? (
        <article class="post-article">
          <h1>{post.title}</h1>
          <time class="post-date">{new Date(post.created_at).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          <div class="post-content" set:html={post.content.replace(/\n/g, '<br/>')} />
        </article>
      ) : (
        <div class="post-not-found">
          <p>这篇文章还没有被写出来呢～</p>
          <a href="/blog">← 回到杉汐的日记本</a>
        </div>
      )}
    </div>
  </body>
</html>