---
import NavBar from '../../components/NavBar.astro';
import ChatWidget from '../../components/shanxi/ChatWidget.vue';
import BlogPost from '../../components/blog/BlogPost.vue';

export function getStaticPaths() {
  return [
    { params: { slug: 'hello-world' } },
    // 后续发布新博客后，在这里追加新的 slug
  ];
}

const { slug } = Astro.params;
---

<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>文章 | 杉汐的日记本</title>
    <style>
      @import "/src/styles/global.css";

      /* ---- 详情页专属布局 ---- */
      .article-page {
        max-width: 800px;
        margin: 100px auto 60px;  /* 避开顶部导航栏 */
        padding: 0 24px;
      }

      /* 文章容器：白底极简，无背景色 */
      .article-page article {
        padding: 0;
        background: transparent;
      }

      /* 标题：蓝色渐变，字号适中 */
      .article-page h1 {
        font-size: 2.2rem;
        font-weight: 700;
        background: linear-gradient(135deg, #2563eb, #60a5fa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.5rem;
        line-height: 1.3;
      }

      /* 日期：小号，灰色 */
      .article-page time,
      .article-page .post-date {
        display: block;
        font-size: 0.9rem;
        color: #64748b;
        margin-bottom: 2rem;
        border-left: 3px solid #2563eb;
        padding-left: 0.75rem;
      }

      /* 正文排版：行距、字号、颜色 */
      .article-page .post-content {
        font-size: 1.05rem;
        line-height: 1.8;
        color: #334155;
      }

      /* 正文段落间距 */
      .article-page .post-content p {
        margin-bottom: 1.2rem;
      }

      /* 图片自适应 */
      .article-page .post-content img {
        max-width: 100%;
        border-radius: 8px;
        margin: 1rem 0;
      }

      /* 代码块优化 */
      .article-page .post-content pre {
        background: #f1f5f9;
        padding: 1rem;
        border-radius: 8px;
        overflow-x: auto;
      }

      /* 未找到文章 */
      .article-page .post-not-found {
        text-align: center;
        padding: 80px 0;
        color: #94a3b8;
      }
      .article-page .post-not-found a {
        color: #2563eb;
        text-decoration: none;
        font-weight: 500;
      }
    </style>
  </head>
  <body>
    <NavBar />
    <ChatWidget client:only="vue" />

    <div class="article-page">
      <BlogPost client:only="vue" slug={slug!} />
    </div>
  </body>
</html>